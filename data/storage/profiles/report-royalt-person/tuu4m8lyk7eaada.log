{"type":"error","timestamp":1759885198510,"entity":{"shortid":"EKDu6wp7U","name":"report-royalt-person","content":"<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\" />\n    <title>Self-Billing Invoice</title>\n    <style>\n        body { font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; font-size: 10pt; color: #333; }\n        table { width: 100%; border-collapse: collapse; table-layout: fixed; }\n        th, td { padding: 5px 4px; text-align: left; vertical-align: top; word-wrap: break-word; }\n        .main-table > tbody > tr > td { padding-top: 2px; padding-bottom: 2px; }\n        .header-title { font-size: 20pt; font-weight: bold; }\n        .header-logo { font-size: 16pt; font-weight: bold; text-align: right; }\n        .playback-color { color: #6C5CE7; }\n        .section-title { font-weight: bold; color: #888; font-size: 8pt; padding-bottom: 0; }\n        .text-right { text-align: right; }\n        .text-bold { font-weight: bold; }\n        .summary-table { margin-top: 20px; border-top: 2px solid #000; border-bottom: 2px solid #000; }\n        .summary-table th { border-bottom: 1px solid #000; padding-top: 8px; padding-bottom: 8px; }\n        .summary-table td { padding-top: 8px; padding-bottom: 8px; }\n        .totals-section td { border-top: 1px solid #ccc; padding-top: 4px; padding-bottom: 4px; }\n        .total-payable { font-size: 11pt; }\n        .vat-note { font-size: 8pt; color: #666; padding-top: 0; }\n        .footer-note, .page-footer { margin-top: 30px; font-size: 9pt; }\n        .page-footer { padding-top: 10px; border-top: 1px solid #ccc; font-size: 8pt; color: #555; text-align: center; }\n        .page-footer p { margin: 2px 0; }\n    </style>\n</head>\n<body>\n    <table class=\"main-table\">\n        <colgroup>\n            <col style=\"width: 50%\" />\n            <col style=\"width: 50%\" />\n        </colgroup>\n        <tbody>\n            <tr>\n                <td class=\"header-title\" colspan=\"2\">Self-Billing Invoice</td>\n            </tr>\n            <tr>\n                <td style=\"padding-bottom: 10px;\">Royalty management services provided by Playback</td>\n                <td class=\"header-logo\" style=\"padding-bottom: 10px;\"><span class=\"playback-color\">PlayBack</span></td>\n            </tr>\n            <tr>\n                <td>\n                    <p class=\"section-title\">RECIPIENT (COLLABORATOR)</p>\n                    <p>\n                        <span class=\"text-bold\">{{:collaborator.full_name}}</span><br />\n                        {{:collaborator.address}}<br />\n                        {{:collaborator.postal_code}} {{:collaborator.city}}<br />\n                        {{:collaborator.country}}\n                    </p>\n                    <p>\n                        {{if invoiceType === 'person'}}\n                            Person ID Number: {{:collaborator.person_id}}<br />\n                        {{else}}\n                            Company Registration Number: {{:collaborator.organisation_number}}<br />\n                            VAT Number: {{:collaborator.vat_number}}<br />\n                        {{/if}}\n                        Client ID: {{:collaborator.id}}\n                    </p>\n                </td>\n                <td>\n                    <p class=\"section-title\">ISSUED BY PLAYBACK ON BEHALF OF (REGISTRANT)</p>\n                    <p>\n                        <span class=\"text-bold\">{{:registrant.public_name}}</span><br />\n                        {{:registrant.address}}<br />\n                        {{:registrant.postal_code}} {{:registrant.city}}<br />\n                        {{:registrant.country}}\n                    </p>\n                    <p>\n                        Company Registration Number: {{:registrant.organisation_number}}<br />\n                        VAT Number: {{:registrant.vat_number}}<br />\n                        Client ID: {{:registrant.id}}\n                    </p>\n                </td>\n            </tr>\n            <tr><td colspan=\"2\" style=\"padding-top: 15px;\"></td></tr>\n            <tr>\n                <td>\n                    <span class=\"text-bold\">Invoice No.:</span> {{:invoiceNumber}}<br />\n                    <span class=\"text-bold\">Date Issued:</span> {{:dateIssued}}\n                </td>\n                <td class=\"text-right\">\n                    <span class=\"text-bold\">Period Covered:</span> {{:periodCovered}}<br />\n                    <span class=\"text-bold\">Currency:</span> {{:bank_detail.currency_id}}\n                </td>\n            </tr>\n             <tr><td colspan=\"2\" class=\"text-bold\" style=\"padding-top: 10px;\">Self-billing</td></tr>\n        </tbody>\n    </table>\n\n    <table class=\"summary-table\">\n        <colgroup>\n            <col style=\"width: 50%\" />\n            <col style=\"width: 25%\" />\n            <col style=\"width: 25%\" />\n        </colgroup>\n        <thead>\n            <tr>\n                {{if invoiceType === 'person'}}\n                    <th>Distributor</th>\n                {{else}}\n                    <th>Item</th>\n                {{/if}}\n                <th>Period</th>\n                <th class=\"text-right\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {{for lineItems}}\n            <tr>\n                <td>{{:description}}</td>\n                <td>{{:period}}</td>\n                <td class=\"text-right\">{{:amount}}</td>\n            </tr>\n            {{/for}}\n            \n            <tr class=\"totals-section\">\n                <td colspan=\"2\" class=\"text-right\">Sub total:</td>\n                <td class=\"text-right\">{{:subTotal}}</td>\n            </tr>\n            <tr>\n                <td colspan=\"3\" class=\"vat-note\">\n                    {{if invoiceType === 'company-dkk'}}\n                        (Amount, VAT exempt: 0.00 Amount, subj. to VAT {{:subTotal}})\n                    {{else invoiceType === 'company'}}\n                         (Amount VAT exempt {{:subTotal}}-Amount, subj to VAT: 0.00)\n                    {{/if}}\n                </td>\n            </tr>\n\n            {{if invoiceType === 'company-dkk'}}\n                <tr>\n                    <td colspan=\"2\" class=\"text-right\">25% VAT:</td>\n                    <td class=\"text-right\">{{:vatAmount}}</td>\n                </tr>\n            {{else invoiceType === 'company'}}\n                <tr>\n                    <td colspan=\"2\" class=\"text-right\">0% VAT:</td>\n                    <td class=\"text-right\">0.00</td>\n                </tr>\n                <tr>\n                    <td colspan=\"3\" class=\"vat-note\">\n                        Reverse charge–VAT to be accounted for by the recipient under Article 196 of Directive 2006/112/EC\n                    </td>\n                </tr>\n            {{else}} <tr>\n                    <td colspan=\"2\" class=\"text-right\">0% VAT:</td>\n                    <td class=\"text-right\">0.00</td>\n                </tr>\n            {{/if}}\n            \n            <tr class=\"total-payable\">\n                <td colspan=\"2\" class=\"text-bold text-right\">Net Payable</td>\n                <td class=\"text-bold text-right\">{{:netPayable}} {{:bank_detail.currency_id}}</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div style=\"margin-top: 30px;\">\n        <h3 style=\"font-size: 11pt; margin-bottom: 10px;\">Payment Details</h3>\n        <p style=\"margin: 4px 0;\"><b>Name of Bank Account Holder:</b> {{:bank_detail.account_holder_name}}</p>\n        <p style=\"margin: 4px 0;\"><b>Bank Account Number:</b> {{:bank_detail.account_number}}</p>\n        <p style=\"margin: 4px 0;\"><b>Bank Registration Number:</b> {{:bank_detail.registration_number}}</p>\n        <p style=\"margin: 4px 0;\"><b>Bank Country:</b> {{:bank_detail.bank_country}}</p>\n        <p style=\"margin: 4px 0;\"><b>IBAN:</b> {{:bank_detail.iban}}</p>\n        <p style=\"margin: 4px 0;\"><b>SWIFT/BIC code:</b> {{:bank_detail.swift}}</p>\n    </div>\n\n    <div class=\"footer-note\">\n        <p>This document serves as a self-billing invoice prepared by Playback ApS. It can be used as documentation for accounting and tax reporting purposes. Please contact us if you have any questions.</p>\n    </div>\n\n    <div class=\"page-footer\">\n        <p class=\"text-bold\"><span class=\"playback-color\">Playback ApS</span></p>\n        <p>Toldbodgade 89-1253 Copenhagen Denmark Company reg. no.: 43092847</p>\n        <p>info@playback.studio</p>\n    </div>\n</body>\n</html>"},"property":"helpers","statusCode":400,"weak":true,"logged":true,"previousOperationId":"75mh22rv0r134t5","id":"te00atiql1oi4uo","stack":"TypeError: Cannot read properties of null (reading 'currency_id')\n  at Function.anonymous [as fn] (eval at <anonymous> (eval at makeEvaluate (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/ses/index.js:7936:27)), <anonymous>:33:23)\n  at Function.renderContent [as render] (/home/thiago/Documentos/Playback/jsreportapp/node_modules/jsrender/jsrender-node.js:1671:20)\n  at Object.execute (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/jsreport-jsrender/lib/jsrenderEngine.js:26:29)\n  at executionFn (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/jsreport-core/lib/worker/render/executeEngine.js:273:42)\n  at eval (sandbox.js:13:18)\n  at async run (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/jsreport-core/lib/worker/sandbox/createSandbox.js:132:18)\n  at async WorkerReporter.runInSandbox [as _runInSandbox] (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/jsreport-core/lib/worker/sandbox/runInSandbox.js:214:14)\n  at async executeEngine (/home/thiago/Documentos/Playback/jsreportapp/node_modules/@jsreport/jsreport-core/lib/worker/render/executeEngine.js:354:16)\n  at async engine.engine (/home/thiag